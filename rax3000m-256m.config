# RAX3000M NAND 256M Flash 配置
# ImmortalWrt 25.12 (openwrt-25.12)
# 在 workflow 中通过 make defconfig 自动展开

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m=y

# 如果你需要 RAX3000Me（带 USB 版本），改为下面的：
# CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000me=y

# ------ 基础工具（推荐）------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lm-sensors=y

# ------ Luci 相关 ------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# ------ 网络工具 ------
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y

# ------ 文件系统支持 ------
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# ------ 语言支持 ------
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-cp950=y
CONFIG_PACKAGE_kmod-nls-utf8=y
